# From @BotFather
TELEGRAM_BOT_TOKEN=

# Random string (letters, digits, _ and -, up to 256 chars). Telegram sends it
# back on every webhook call so we can reject forged requests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the cron endpoint.
CRON_SECRET=
